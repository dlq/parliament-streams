{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dlq/parliament-streams/schema/channels.schema.json",
  "title": "Parliament Streams Catalogue",
  "type": "object",
  "required": ["schema_version", "generated_from", "generated_on", "description", "channels"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "generated_from": { "type": "string", "minLength": 1 },
    "generated_on": { "type": "string", "format": "date" },
    "description": { "type": "string", "minLength": 1 },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/channel" }
    }
  },
  "$defs": {
    "channel": {
      "type": "object",
      "required": [
        "id",
        "name",
        "jurisdiction_level",
        "country_or_region",
        "legislature",
        "language",
        "source_type",
        "playback_url",
        "official_url",
        "attribution_text",
        "technical_status",
        "availability",
        "program",
        "epg_sources",
        "permission"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "jurisdiction_level": { "type": "string", "minLength": 1 },
        "country_or_region": { "type": "string", "minLength": 1 },
        "legislature": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 1 },
        "source_type": {
          "type": "string",
          "enum": ["direct_hls", "direct_dash", "official_page", "youtube"]
        },
        "playback_url": {
          "anyOf": [
            { "type": "string", "format": "uri" },
            { "type": "null" }
          ]
        },
        "official_url": { "type": "string", "format": "uri" },
        "attribution_text": { "type": "string", "minLength": 1 },
        "technical_status": {
          "type": "string",
          "enum": ["validated", "needs_review", "link_only"]
        },
        "availability": {
          "type": "string",
          "enum": ["always_on", "sitting_only", "event_based"]
        },
        "program": { "$ref": "#/$defs/program" },
        "epg_sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/epg_source" }
        },
        "permission": { "$ref": "#/$defs/permission" }
      }
    },
    "program": {
      "type": "object",
      "required": [
        "current_event_title",
        "current_event_time",
        "next_event_title",
        "next_event_time",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "current_event_title": { "type": "string", "minLength": 1 },
        "current_event_time": { "type": "string", "minLength": 1 },
        "next_event_title": { "type": "string", "minLength": 1 },
        "next_event_time": { "type": "string", "minLength": 1 },
        "confidence": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        }
      }
    },
    "epg_source": {
      "type": "object",
      "required": ["scraper", "scraper_status", "url", "method", "kind"],
      "additionalProperties": false,
      "properties": {
        "scraper": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "scraper_status": {
          "type": "string",
          "enum": ["implemented", "planned"]
        },
        "url": { "type": "string", "format": "uri" },
        "method": { "type": "string", "enum": ["GET", "POST"] },
        "kind": { "type": "string", "minLength": 1 }
      }
    },
    "permission": {
      "type": "object",
      "required": ["status", "summary", "evidence", "recommendation"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "personal_use_pending_review",
            "noncommercial_pending_review",
            "explicit_reuse_with_conditions",
            "embed_only",
            "no_third_party_reuse"
          ]
        },
        "summary": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        },
        "recommendation": { "type": "string", "minLength": 1 }
      }
    }
  }
}
