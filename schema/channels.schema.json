{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dlq/parliament-streams/schema/channels.schema.json",
  "title": "Parliament Streams Catalogue",
  "type": "object",
  "required": ["schema_version", "generated_from", "generated_on", "description", "channels"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "generated_from": { "type": "string", "minLength": 1 },
    "generated_on": { "type": "string", "format": "date" },
    "description": { "type": "string", "minLength": 1 },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/channel" }
    }
  },
  "$defs": {
    "channel": {
      "type": "object",
      "required": [
        "id",
        "name",
        "jurisdiction_level",
        "country_or_region",
        "legislature",
        "external_ids",
        "identity_sources",
        "language",
        "source_type",
        "playback_url",
        "official_url",
        "provenance_note",
        "technical_status",
        "availability",
        "accessibility",
        "epg_sources",
        "permission"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "jurisdiction_level": { "type": "string", "minLength": 1 },
        "country_or_region": { "type": "string", "minLength": 1 },
        "legislature": { "type": "string", "minLength": 1 },
        "external_ids": { "$ref": "#/$defs/external_ids" },
        "identity_sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identity_source" }
        },
        "language": { "type": "string", "minLength": 1 },
        "source_type": {
          "type": "string",
          "enum": ["direct_hls", "direct_dash", "official_page", "youtube"]
        },
        "playback_url": {
          "anyOf": [
            { "type": "string", "format": "uri" },
            { "type": "null" }
          ]
        },
        "embed": { "$ref": "#/$defs/embed" },
        "official_url": { "type": "string", "format": "uri" },
        "provenance_note": { "type": "string", "minLength": 1 },
        "technical_status": {
          "type": "string",
          "enum": ["validated", "needs_review", "link_only"]
        },
        "availability": {
          "type": "string",
          "enum": ["always_on", "sitting_only", "event_based"]
        },
        "accessibility": { "$ref": "#/$defs/accessibility" },
        "epg_sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/epg_source" }
        },
        "permission": { "$ref": "#/$defs/permission" }
      }
    },
    "external_ids": {
      "type": "object",
      "required": [
        "wikidata_qid",
        "ipu_country_code",
        "ipu_parliament_code",
        "ipu_chamber_code"
      ],
      "additionalProperties": false,
      "properties": {
        "wikidata_qid": {
          "anyOf": [
            { "type": "string", "pattern": "^Q[1-9][0-9]*$" },
            { "type": "null" }
          ]
        },
        "ipu_country_code": {
          "anyOf": [
            { "type": "string", "pattern": "^[A-Z]{2}$" },
            { "type": "null" }
          ]
        },
        "ipu_parliament_code": {
          "anyOf": [
            { "type": "string", "pattern": "^[A-Z]{2}$" },
            { "type": "null" }
          ]
        },
        "ipu_chamber_code": {
          "anyOf": [
            { "type": "string", "pattern": "^[A-Z]{2}-(LC|UC)[0-9]{2}$" },
            { "type": "null" }
          ]
        }
      }
    },
    "identity_source": {
      "type": "object",
      "required": ["source", "url", "checked_on", "confidence", "notes"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "enum": ["wikidata", "ipu_parline"] },
        "url": { "type": "string", "format": "uri" },
        "checked_on": { "type": "string", "format": "date" },
        "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "embed": {
      "type": "object",
      "required": ["provider", "kind", "content_id", "url", "live_url", "notes"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "enum": ["youtube"] },
        "kind": { "type": "string", "enum": ["uploads_playlist"] },
        "content_id": { "type": "string", "pattern": "^UU[A-Za-z0-9_-]+$" },
        "url": { "type": "string", "format": "uri" },
        "live_url": { "type": "string", "format": "uri" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "accessibility": {
      "type": "object",
      "required": [
        "captions",
        "caption_languages",
        "sign_language",
        "audio_description",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "captions": {
          "type": "string",
          "enum": ["available", "source_dependent", "unavailable", "unknown"]
        },
        "caption_languages": {
          "type": "array",
          "items": { "type": "string", "minLength": 2 }
        },
        "sign_language": {
          "type": "string",
          "enum": ["available", "source_dependent", "unavailable", "unknown"]
        },
        "audio_description": {
          "type": "string",
          "enum": ["available", "source_dependent", "unavailable", "unknown"]
        },
        "notes": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        }
      }
    },
    "epg_source": {
      "type": "object",
      "required": ["scraper", "scraper_status", "url", "method", "kind"],
      "additionalProperties": false,
      "properties": {
        "scraper": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "scraper_status": {
          "type": "string",
          "enum": ["implemented", "planned"]
        },
        "url": { "type": "string", "format": "uri" },
        "method": { "type": "string", "enum": ["GET", "POST"] },
        "kind": { "type": "string", "minLength": 1 }
      }
    },
    "permission": {
      "type": "object",
      "required": ["status", "summary", "evidence", "recommendation"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "personal_use_pending_review",
            "noncommercial_pending_review",
            "explicit_reuse_with_conditions",
            "embed_only",
            "no_third_party_reuse"
          ]
        },
        "summary": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        },
        "recommendation": { "type": "string", "minLength": 1 }
      }
    }
  }
}
