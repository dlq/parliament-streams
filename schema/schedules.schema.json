{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dlq.github.io/parliament-streams/schema/schedules.schema.json",
  "title": "Parliament Streams schedule snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "refresh_interval_hours",
    "counts",
    "channels",
    "sources"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "refresh_interval_hours": { "const": 6 },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "empty", "error", "channels"],
      "properties": {
        "ok": { "type": "integer", "minimum": 0 },
        "empty": { "type": "integer", "minimum": 0 },
        "error": { "type": "integer", "minimum": 0 },
        "channels": { "type": "integer", "minimum": 0 }
      }
    },
    "channels": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/schedule" }
    },
    "sources": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_event_title",
        "current_event_time",
        "next_event_title",
        "next_event_time",
        "confidence",
        "scraper",
        "source_url",
        "fetched_at"
      ],
      "properties": {
        "current_event_title": { "type": "string", "minLength": 1 },
        "current_event_time": { "type": "string", "minLength": 1 },
        "next_event_title": { "type": ["string", "null"] },
        "next_event_time": { "type": ["string", "null"] },
        "confidence": { "type": "string", "minLength": 1 },
        "scraper": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri" },
        "fetched_at": { "type": "string", "format": "date-time" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "fetched_at", "urls", "channel_count"],
      "properties": {
        "status": { "enum": ["ok", "empty", "error"] },
        "fetched_at": { "type": "string", "format": "date-time" },
        "urls": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri" }
        },
        "channel_count": { "type": "integer", "minimum": 0 },
        "error": { "type": "string", "minLength": 1 }
      }
    }
  }
}
