{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dlq/parliament-streams/schema/fallbacks.schema.json",
  "title": "Parliament Streams Fallback Sources",
  "type": "object",
  "required": ["schema_version", "generated_on", "description", "fallbacks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "generated_on": { "type": "string", "format": "date" },
    "description": { "type": "string", "minLength": 1 },
    "fallbacks": {
      "type": "array",
      "items": { "$ref": "#/$defs/fallback" }
    }
  },
  "$defs": {
    "fallback": {
      "type": "object",
      "required": [
        "id",
        "related_channel_ids",
        "label",
        "jurisdiction_level",
        "country_or_region",
        "legislature",
        "fallback_type",
        "official_url",
        "integration_mode",
        "playback_claim",
        "schedule_role",
        "stability_risk",
        "rights_status",
        "evidence_urls",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "related_channel_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        },
        "label": { "type": "string", "minLength": 1 },
        "jurisdiction_level": {
          "type": "string",
          "enum": ["national", "subnational", "supranational"]
        },
        "country_or_region": { "type": "string", "minLength": 1 },
        "legislature": { "type": "string", "minLength": 1 },
        "fallback_type": {
          "type": "string",
          "enum": [
            "official_event_platform",
            "official_live_page",
            "official_youtube_live",
            "official_youtube_uploads",
            "official_archive",
            "official_broadcaster"
          ]
        },
        "official_url": { "type": "string", "format": "uri" },
        "integration_mode": {
          "type": "string",
          "enum": ["link_out", "provider_embed", "planned_event_resolver"]
        },
        "playback_claim": {
          "type": "string",
          "enum": [
            "no_direct_stream_claim",
            "provider_managed_embed",
            "unsupported_native_playback",
            "event_specific_research"
          ]
        },
        "schedule_role": {
          "type": "string",
          "enum": ["schedule_source", "now_next_possible", "none"]
        },
        "stability_risk": {
          "type": "string",
          "enum": ["low", "medium", "high", "unknown"]
        },
        "rights_status": {
          "type": "string",
          "enum": [
            "personal_use_pending_review",
            "noncommercial_pending_review",
            "explicit_reuse_with_conditions",
            "embed_only",
            "no_third_party_reuse"
          ]
        },
        "evidence_urls": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri" }
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
