{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dlq/parliament-streams/schema/us-legislature-candidates.schema.json",
  "title": "United States legislative video candidates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_version",
    "generated_on",
    "scope",
    "method",
    "authoritative_directory_url",
    "federal_candidates",
    "state_candidates"
  ],
  "properties": {
    "candidate_version": { "const": 1 },
    "generated_on": { "type": "string", "format": "date" },
    "scope": { "type": "string", "minLength": 1 },
    "method": { "type": "string", "minLength": 1 },
    "authoritative_directory_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "federal_candidates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "state_candidates": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/candidate" },
          {
            "type": "object",
            "required": ["state", "postal_code"],
            "properties": {
              "state": { "type": "string", "minLength": 1 },
              "postal_code": { "type": "string", "pattern": "^[A-Z]{2}$" }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "institution",
        "candidate_type",
        "official_url",
        "video_url",
        "schedule_url",
        "research_status",
        "priority",
        "evidence_urls",
        "notes"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "institution": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 },
        "postal_code": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "candidate_type": {
          "enum": [
            "floor_channel",
            "committee_platform",
            "legislature_platform",
            "broadcaster_fallback"
          ]
        },
        "official_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "video_url": {
          "type": ["string", "null"],
          "format": "uri",
          "pattern": "^https://"
        },
        "schedule_url": {
          "type": ["string", "null"],
          "format": "uri",
          "pattern": "^https://"
        },
        "research_status": {
          "enum": [
            "verified_official_video_surface",
            "existing_fallback",
            "official_root_recorded",
            "blocked_or_changed"
          ]
        },
        "priority": { "enum": ["high", "medium", "research"] },
        "evidence_urls": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri", "pattern": "^https://" }
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
