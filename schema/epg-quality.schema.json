{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dlq.github.io/parliament-streams/schema/epg-quality.schema.json",
  "title": "Parliament Streams EPG quality report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "counts",
    "channels"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events",
        "exportable",
        "excluded",
        "channels_with_events"
      ],
      "properties": {
        "events": {
          "$ref": "#/$defs/count"
        },
        "exportable": {
          "$ref": "#/$defs/count"
        },
        "excluded": {
          "$ref": "#/$defs/count"
        },
        "channels_with_events": {
          "$ref": "#/$defs/count"
        }
      },
      "patternProperties": {
        "^excluded_[a-z_]+$": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "channels": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/channel_quality"
      }
    },
    "coverage": {
      "$ref": "#/$defs/guide_coverage"
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "exclusion_reason": {
      "enum": [
        "unverified_channel_mapping",
        "duplicate_id",
        "cancelled",
        "empty_title",
        "missing_time_range",
        "assumed_broadcast_date",
        "invalid_timestamp",
        "nonpositive_duration",
        "duplicate_programme",
        "overlapping_programme"
      ]
    },
    "channel_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "scope",
        "linear_guide_eligible",
        "events",
        "exportable",
        "overlap_pairs",
        "inferred_ends",
        "assumed_dates",
        "stale",
        "exclusions",
        "excluded_events"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "broadcast_schedule",
            "event_directory",
            "institutional_agenda",
            "live_event_metadata",
            "unreviewed"
          ]
        },
        "linear_guide_eligible": {
          "type": "boolean"
        },
        "events": {
          "$ref": "#/$defs/count"
        },
        "exportable": {
          "$ref": "#/$defs/count"
        },
        "overlap_pairs": {
          "$ref": "#/$defs/count"
        },
        "inferred_ends": {
          "$ref": "#/$defs/count"
        },
        "assumed_dates": {
          "$ref": "#/$defs/count"
        },
        "stale": {
          "type": "boolean"
        },
        "exclusions": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/exclusion_reason"
          },
          "additionalProperties": {
            "$ref": "#/$defs/count"
          }
        },
        "excluded_events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "reasons"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "reasons": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/exclusion_reason"
                }
              }
            }
          }
        }
      }
    },
    "guide_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counts",
        "channels"
      ],
      "properties": {
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "catalogue_sources",
            "channels_with_parser",
            "channels_with_reviewed_mapping",
            "channels_with_events",
            "channels_with_programmes"
          ],
          "properties": {
            "catalogue_sources": {
              "$ref": "#/$defs/count"
            },
            "channels_with_parser": {
              "$ref": "#/$defs/count"
            },
            "channels_with_reviewed_mapping": {
              "$ref": "#/$defs/count"
            },
            "channels_with_events": {
              "$ref": "#/$defs/count"
            },
            "channels_with_programmes": {
              "$ref": "#/$defs/count"
            }
          }
        },
        "channels": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/channel_coverage"
          }
        }
      }
    },
    "channel_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parser_ids",
        "reviewed_parser_ids",
        "events",
        "exportable",
        "state"
      ],
      "properties": {
        "parser_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reviewed_parser_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "events": {
          "$ref": "#/$defs/count"
        },
        "exportable": {
          "$ref": "#/$defs/count"
        },
        "state": {
          "enum": [
            "parser_planned",
            "not_collected",
            "empty",
            "collection_error",
            "mapping_unverified",
            "quality_hold",
            "guide_available"
          ]
        }
      }
    }
  }
}
