{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dlq/parliament-streams/schema/discovery-targets.schema.json",
  "title": "Parliamentary stream discovery targets",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_version",
    "tier",
    "source_report",
    "scope",
    "method",
    "countries"
  ],
  "properties": {
    "target_version": { "const": 1 },
    "tier": { "enum": ["tier1", "tier2"] },
    "source_report": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "method": { "type": "string", "minLength": 1 },
    "countries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["country", "results"],
        "properties": {
          "country": { "type": "string", "minLength": 1 },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "url"],
              "properties": {
                "kind": {
                  "enum": ["hls", "dash", "official_page"]
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                }
              }
            }
          }
        }
      }
    }
  }
}
