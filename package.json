{
  "name": "parliament-streams-site-checks",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "npm run build:vendor",
    "build:vendor": "node tools/build_vendor_assets.mjs",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/*.test.mjs",
    "test:browser": "npm run check:site",
    "check:html": "html-validate site/index.html site/institutions.html site/map.html site/schedule.html",
    "check:browser": "node tools/check_site.mjs",
    "check:a11y": "npm run check:browser",
    "check:site": "npm run check:html && npm run check:browser"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "d3": "^7.9.0",
    "esbuild": "0.28.2",
    "hls.js": "1.7.3",
    "html-validate": "11.16.2",
    "playwright": "1.64.0"
  }
}
