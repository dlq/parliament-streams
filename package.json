{
  "name": "parliament-streams-site-checks",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "npm run build:vendor",
    "build:vendor": "node tools/build_vendor_assets.mjs",
    "check:html": "html-validate site/index.html site/map.html site/schedule.html",
    "check:a11y": "node tools/check_accessibility.mjs",
    "check:site": "npm run check:html && npm run check:a11y"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "d3": "^7.9.0",
    "esbuild": "0.28.2",
    "hls.js": "1.7.3",
    "html-validate": "11.16.0",
    "playwright": "1.63.0"
  }
}
