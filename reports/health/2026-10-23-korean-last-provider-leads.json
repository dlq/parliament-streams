\uc5f0\uc7a5 \uc0ac\ub840\ub97c \uc911\uc2ec\uc73c\ub85c \ud1a0\ub860\ud68c\nOFF\n\ud1a0\ub860\ud68c 2026-10-28 | 14:00\n\uacbd\uae30\ub3c4 \uc0c1\uc218\ub3c4 \ubcf4\uae09 \uaca9\ucc28 \ud574\uc18c\uc640 \ubb3c \ubcf5\uc9c0 \uc2e4\ud604\uc744 \uc704\ud55c \uc7ac\uc815\ubd84\ub2f4 \ud601\uc2e0 \ubc29\uc548 \ud1a0\ub860\ud68c\nOFF\n\ud1a0\ub860\ud68c 2026-10-28 | 14:00\n\uae30\ud6c4\uc704\uae30 \ub300\uc751 \ubc0f \ub3c4\uc2dc\uc548\uc804 \uac15\ud654\ub97c \uc704\ud55c \uc0b0\ubcf8\ucc9c \uc0dd\ud0dc\ubcf5\uc6d0 \uc815\ucc45\ud1a0\ub860\ud68c \ud1a0\ub860\ud68c\nOFF\n\ud1a0\ub860\ud68c 2026-10-28 | 14:00\n\uc7a5\uc560\ud559\uc0dd\u00b7\uc7a5\uc560\uad50\uc9c1\uc6d0 \uc7ac\ub09c\ub300\ud53c \uc9c0\uc6d0\uccb4\uacc4 \uad6c\ucd95\uc744 \uc704\ud55c \uc815\ucc45\ud1a0\ub860\ud68c \"\uad6c\uc870\ub300\uac00 \uc62c \ub54c\uae4c\uc9c0 \ubc84\ud2f0\uc138\uc694\" \ud559\uad50 \uc7ac\ub09c\uc548\uc804\uc758 \uc0ac\uac01\uc9c0\ub300\ub97c \ubb3b\ub2e4 \ud1a0\ub860\ud68c\nOFF\n\ud1a0\ub860\ud68c 2026-10-29 | 14:00\n\ud559\uad50 \uccb4\uc721\uc2dc\uc124 \uac1c\ubc29 \ud655\ub300 \ubc0f \ud6a8\uc728\uc801 \uc6b4\uc601\uc744 \uc704\ud55c \uc815\ucc45\ud1a0\ub860\ud68c \ud1a0\ub860\ud68c\nOFF\n\ud1a0\ub860\ud68c 2026-10-29 | 14:00\n\uc218\uc694\uc790 \uc911\uc2ec\uc758 \uacbd\uae30\ub3c4 \ud1b5\ud569\ub3cc\ubd04 \uad6c\ucd95\ubc29\uc548\uc744 \uc704\ud55c \uc815\ucc45\ud1a0\ub860\ud68c \ud1a0\ub860\ud68c\nOFF\n\ud1a0\ub860\ud68c 2026-10-30 | 14:00\n\ub3c4\ubbfc\uc774 \ubc14\ub77c\ubcf4\ub294 \uacbd\uae30\ub3c4 \uc7ac\uc815 \ud1a0\ub860\ud68c\nOFF\n\ud1a0\ub860\ud68c 2026-10-30 | 13:00\n\ub300\uaddc\ubaa8 \uac1c\ubc1c\uc9c0\uad6c \ud559\uc0dd\uc218\uc6a9\uacc4\ud68d \ud604\uc2e4\ud654 \ubc29\uc548 \ud1a0\ub860\ud68c\nOFF\n\ud1a0\ub860\ud68c 2026-10-30 | 14:00\n\uacbd\uae30\ub3c4 \uc608\ube44\uad70 \uc721\uc131\u00b7\uc9c0\uc6d0\uc758 \uc81c\ub3c4\uc801 \uae30\ubc18 \ub9c8\ub828\uc744 \uc704\ud55c \uc815\ucc45\ud1a0\ub860\ud68c \ud1a0\ub860\ud68c\nOFF\n\ucd5c\uadfc\uc601\uc0c1\n\uc0dd