        },
        {
          "text": "\ucd5c\ub300\uc131 \uc758\uc6d0, \ucc45\uc784\uacfc \uade0\ud615\ubc1c\uc804, \uc2dc\ubbfc\uc774 \uccb4\uac10\ud558\ub294 \uc608\uc0b0 \uc81c\ub3c4 \uc6b4\uc601",
